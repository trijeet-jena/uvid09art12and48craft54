PORT=8787
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@uvid.store
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=Store Admin
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
